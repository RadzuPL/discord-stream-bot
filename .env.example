# Required
DISCORD_TOKEN=
VOICE_CHANNEL_ID=
STREAM_URL=http://host:8084/live.mp3

# Optional
# IDLE_TIMEOUT=60        # seconds without listeners before the stream stops; 0 = always play
# LEAVE_WHEN_EMPTY=true  # true = leave the voice channel when idle, false = stay in it all the time
# VOLUME=1.0
# LOG_LEVEL=INFO
# FFMPEG_BEFORE_OPTIONS=
# HEALTH_FILE=/tmp/streambot.healthy
